DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk"
BETTER_AUTH_SECRET="replace-with-a-random-32-plus-character-string"
BETTER_AUTH_URL="http://localhost:3000"
ANTHROPIC_API_KEY=""
POSTMARK_WEBHOOK_TOKEN=""
RESEND_API_KEY=""
PORT=3000
NODE_ENV=development
E2E_HEADLESS=false

OWN_DOMAIN="helpdesk.com"

# Frontend origin trusted by Better Auth (CSRF). Required in production; defaults to http://localhost:5173 in dev.
CLIENT_URL=http://localhost:5173
POSTMARK_WEBHOOK_TOKEN=

# AI (Plan 07, ADR-0017). All optional; defaults shown.
# ollama (default, local) | claude (not implemented yet) | fake (tests only)
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# Must be a GGUF tag: the -mlx and bare qwen3.8:27b (nvfp4) tags do not support structured output
OLLAMA_MODEL=qwen3.8:27b-q4_K_M
# Per call; the first call also loads the model
AI_TIMEOUT_MS=120000
